# Backend HTTP server and target proxy ports
PORT=3300
PROXY_PORT=3301

# Angular / Ionic project to inspect
TARGET_URL=http://localhost:8100
# Absolute path to the target project root (where src/app and package.json live)
PROJECT_PATH=

# LLM code generation engine: gemini | opencode
LLM_PROVIDER=opencode

# Google Gemini (used only when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenCode V2 service (used only when LLM_PROVIDER=opencode)
# Root URL of the running OpenCode service. Do NOT append /v1.
OPENCODE_BASE_URL=http://localhost:4096
# Optional Bearer token for a remote service; leave blank for a local service
OPENCODE_API_KEY=
# Optional providerID/model reference, e.g. anthropic/claude-sonnet-4.
# Leave blank to use the model configured in opencode.json.
OPENCODE_MODEL=
